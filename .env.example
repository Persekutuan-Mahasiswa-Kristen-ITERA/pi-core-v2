# PI-CORE v2 — environment variables. Copy to .env.local for development. NEVER commit real values.

# Public (shipped to the browser; access is limited by RLS):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY. Bypasses RLS. Used only for Auth admin operations (create user, set password, ban).
# In Vercel: set for Production/Preview only, never with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Local tooling only (integration tests, scripts). Not needed on Vercel.
SUPABASE_DB_URL=
